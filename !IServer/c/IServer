/*
 *   Boot  -  copy the boot file to the link
 */

PRIVATE VOID Boot()
{
   FILE *Fd;
   BYTE Buffer[ BOOT_BUFFER_LENGTH ];
   int Length=0, Count=0;
   INT32 Size=0;
#ifndef RISCOS
   static BYTE Flicks[]="|/-\\|/-\\" ;
   int Flick=0;
#endif

   if ( ( Fd=fopen( (char*)BootFileName, "rb" ) ) == NULL )
      ABORT((SE, "cannot find boot file \"%s\"", BootFileName));
   INFO(("Booting root transputer..."));

#ifdef RISCOS
   visdelay_begin();
#endif

   while ( ( Length = fread( Buffer, 1, BOOT_BUFFER_LENGTH, Fd ) ) > 0 )
      {
         DEBUG(("%d", Length));
         if ( ( Count = WriteLink( TheLink, Buffer, Length, BOOT_TIMEOUT ) ) < 0 )
         {
#ifdef RISCOS
            visdelay_end();
#endif
            ABORT(( SE,"internal error - WriteLink in Boot was bad"));
         }
         Size += Count;
         if ( Count != Length )
         {
#ifdef RISCOS
            visdelay_end();
#endif
            ABORT((SE, "unable to write byte %d to the boot link", Size ));
         }
#ifndef RISCOS
         if ( isatty(1) )
            {
               INFO(( "%c\b", Flicks[Flick] ));
               if ( ++Flick == 8 ) Flick -= 8;
            }
      }
   if ( isatty(1) )
      {
         INFO(( "\r                           \r" ));
      }
   else
#else
      }
      visdelay_end();
#endif
      {
         INFO(("ok\n"));
      }
   DEBUG(( "booted %ld bytes", Size ));
}




/*
 *   Core  -  peek the transputer memory into a buffer
 */

PRIVATE VOID Core()
{
   BYTE Buf[5], *c;
   int a;
   INT32 l;
#ifndef RISCOS
   static BYTE Flicks[]="|\\-/|\\-/" ;
   int Flick=0;
#endif

   INFO(( "Peeking root transputer..." ));
#ifdef RISCOS
   visdelay_begin();
#endif
   Buf[0] = 1;  /*  peek  */
   for( a = 0 ; a < CORE_SIZE ; )
      {
         l = (INT32)(a + 0x80000000L);
         c = (BYTE *)&l;
#ifdef BIG_ENDIAN
         Buf[4]= *c++ ; Buf[3]= *c++ ; Buf[2]= *c++ ; Buf[1]= *c;
#else
         Buf[1]= *c++ ; Buf[2]= *c++ ; Buf[3]= *c++ ; Buf[4]= *c;
#endif
         if ( WriteLink( TheLink, &Buf[0], 5, TIMEOUT ) != 5 )
         {
#ifdef RISCOS
            visdelay_end();
#endif
            ABORT((SE, "timed out peeking word %d", a/4 ));
         }
         if ( ReadLink( TheLink, &Buf[1], 4, TIMEOUT ) != 4 )
         {
#ifdef RISCOS
            visdelay_end();
#endif
            ABORT((SE, "timed out in peek of word %d", a/4 ));
         }
         CoreDump[a++] = Buf[1];
         CoreDump[a++] = Buf[2];
         CoreDump[a++] = Buf[3];
         CoreDump[a++] = Buf[4];

#ifndef RISCOS
         if ( isatty(1) )
            if ( (a & 0xff) == 0 )
               {
                  INFO(( "%c\b", Flicks[Flick] ));
                  if ( ++Flick == 8 ) Flick -= 8;
               }
      }
   if ( isatty(1) )
      {
         INFO(( "\r                           \r" ));
      }
   else
#else
      }
      visdelay_end();
#endif
      {
         INFO(("ok\n"));
      }
   DEBUG(( "peeked %d bytes", a ));
}




