#include "event.h"
#include "os.h"
#include "swis.h"
#include "win.h"

#include "DWindow.h"

extern wimp_w Window;
extern int    WindowActive;

extern int TestRead (int);
extern int TestWrite(int);
extern int _ReadLink (int, char*, unsigned int, int);
extern int _WriteLink(int, char*, unsigned int, int);


/* Read monotonic time ---------------------------------------------------------------------------------- */

static unsigned int MonotonicTime(void)
{
  int t;
  (void)os_swi1r(OS_ReadMonotonicTime | XOS_Bit, 0, &t);
  return t;
}

/* ReadLink() ------------------------------------------------------------------------------------------- */

int ReadLink(int LinkId, char* Buffer, unsigned int Count, int Timeout)
{
  int          i, n = 0;
  unsigned int time = MonotonicTime() + Timeout*10;
  wimp_emask   mask;

  if (WindowActive)
  {
    mask = event_getmask();
    win_claim_idle_events(Window);
    event_setmask(mask & ~wimp_EMNULL);
#ifdef DWINDOW
    DWindow_Select(DWindow_Read);
#endif
  }

  while (Count != 0)
  {
    if (TestRead(LinkId))
    {
      i = _ReadLink(LinkId, Buffer, Count, WindowActive ? 1 : Timeout);
      Buffer += i;
      Count  -= i;
      n      += i;
    }
    if (Timeout != 0 && (MonotonicTime() - time) < 0x80000000) break;
    if (WindowActive) event_process();
  }

  if (WindowActive)
  {
    win_claim_idle_events((wimp_w) -1);
    event_setmask(mask);
#ifdef DWINDOW
    DWindow_Select(DWindow_None);
#endif
  }

  return n;
}

/* WriteLink() ------------------------------------------------------------------------------------------ */

int WriteLink(int LinkId, char* Buffer, unsigned int Count, int Timeout)
{
  int          i, n = 0;
  unsigned int time = MonotonicTime() + Timeout*10;
  wimp_emask   mask;

  if (WindowActive)
  {
    mask = event_getmask();
    win_claim_idle_events(Window);
    event_setmask(mask & ~wimp_EMNULL);
#ifdef DWINDOW
    DWindow_Select(DWindow_Write);
#endif
  }

  while (Count != 0)
  {
    if (TestWrite(LinkId))
    {
      i = _WriteLink(LinkId, Buffer, Count, WindowActive ? 1 : Timeout);
      Buffer += i;
      Count  -= i;
      n      += i;
    }
    if (Timeout != 0 && (MonotonicTime() - time) < 0x80000000) break;
    if (WindowActive) event_process();
  }

  if (WindowActive)
  {
    win_claim_idle_events((wimp_w) -1);
    event_setmask(mask);
#ifdef DWINDOW
    DWindow_Select(DWindow_None);
#endif
  }

  return n;
}

