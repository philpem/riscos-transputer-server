/*
 *   SpError
 */

#ifdef __STDC__
PUBLIC VOID SpError(void)
#else
PUBLIC VOID SpError()
#endif
{
   BUFFER_DECLARATIONS;
   FILE *Fd;
   INT32 Errno;
   BYTE String[128];

   DEBUG(( "SP.ERROR" ));
   INIT_BUFFERS;

   GET_FD( Fd );
   DEBUG(( "fd %0X", (int)Fd ));
   switch( (int)Fd )
      {
         case 0 : Fd = stdin; break;
         case 1 : Fd = stdout; break;
         case 2 : Fd = stderr; break;
      }

   if( ferror(Fd) )
      {
         PUT_BYTE( SP_SUCCESS );
         Errno = errno;
         DEBUG(( "errno %d", Errno ));
         PUT_INT32( Errno );
#ifdef SUN3
         String[0] = 0;
#else
         strcpy( (char*)&String[0], strerror(errno));
#endif
         DEBUG(( "error \"%s\"", &String[0]));
         Size = strlen((char*)&String[0]);
         PUT_SLICE( Size, String[0] );
         REPLY;
      }
   else
      {
         PUT_BYTE( SP_ERROR );
         REPLY;
      }
}




/*
 *   SpRemove
 */

#ifdef __STDC__
PUBLIC VOID SpRemove(void)
#else
PUBLIC VOID SpRemove()
#endif
{
   BUFFER_DECLARATIONS;
   BYTE *Name;

   DEBUG(( "SP.REMOVE" ));
   INIT_BUFFERS;

   Name = &DataBuffer[0];
   GET_SLICE( Size, Name ); DataBuffer[Size] = 0; DEBUG(( "\"%s\"", Name ));
   if ( *Name == 0 )
      {
         PUT_BYTE( SP_ERROR );
      }
   else
      {
#ifdef SUN3
         if( unlink( Name ) )
#else
         if( remove( (char*)Name ) )
#endif
            {
               PUT_BYTE( SP_ERROR );
            }
         else
            {
               PUT_BYTE( SP_SUCCESS );
            }
      }
   REPLY;
}



/*
 *   SpRename
 */

#ifdef __STDC__
PUBLIC VOID SpRename(void)
#else
PUBLIC VOID SpRename()
#endif
{
   BUFFER_DECLARATIONS;
   BYTE *Oldname, *Newname;

   DEBUG(( "SP.RENAME" ));
   INIT_BUFFERS;
   Oldname = &DataBuffer[0];
   GET_SLICE( Size, Oldname ); *(Oldname+Size)=0; DEBUG(( "old \"%s\"", Oldname ));

   Newname = Oldname+Size+1;
   GET_SLICE( Size, Newname ); *(Newname+Size)=0; DEBUG(( "new \"%s\"", Newname ));

   if ( *Oldname == 0 )
      {
         PUT_BYTE( SP_ERROR );
      }
   else
      {
         if ( *Newname == 0 )
            {
               PUT_BYTE( SP_ERROR );
            }
          else
            {
               if( rename( (char*)Oldname, (char*)Newname ) )
                  {
                     PUT_BYTE( SP_ERROR );
                  }
               else
                  {
                     PUT_BYTE( SP_SUCCESS );
                  }
            }
      }
   REPLY;

}

