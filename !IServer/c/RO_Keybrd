#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "inmos.h"
#include "iserver.h"

#include "event.h"
#include "os.h"
#include "wimp.h"
#include "wimpt.h"

#include "DWindow.h"

/*
 *      KeyLength defines the length of the internal circular buffer
 *
 *      Keys[] is the circular buffer storing keypresses (as Wimp codes)
 *      KeyCount counts the number of characters in the buffer
 *      KeyPut and KeyGet are the insertion and removal indices
 *      EscPending is set when the user presses the Escape key.
 *        Because we use ESC (27) as the prefix for a special (>=0x100)
 *        keycode, we send ESC twice. This is technically keycode 0x11B,
 *        but RISC OS doesn't assign that code to a key.
 */

#define KeyLength 256

PRIVATE int  Keys[KeyLength];
PRIVATE int  KeyCount   = 0;
PRIVATE int  KeyPut     = 0;
PRIVATE int  KeyGet     = 0;
PRIVATE BOOL EscPending = FALSE;

#define ESC 27

EXTERN BOOL WindowActive;

/* Buffer insertion ===================================================================================== */

/* Insert keypress into buffer -------------------------------------------------------------------------- */

PUBLIC VOID KeyPressed(int key)
{
  /* Ignore all f12 variants */
  if ((key & 0x1cf) == 0x1cc)
  {
    wimpt_noerr(wimp_processkey(key));
  }
  /* Ignore keypress if buffer full */
  else if (KeyCount < KeyLength)
  {
    KeyCount++;
    Keys[KeyPut++] = (key == 13 ? 10 : key);
    if (KeyPut >= KeyLength) KeyPut = 0;
  }
}

/* Buffer removal ======================================================================================= */

/* Poll for key press ----------------------------------------------------------------------------------- */

PUBLIC int PollKey(void)
{
  if (EscPending) {
    /* If there's a pending 27,27 (from Escape key) send it and leave KeyCount alone */
    EscPending = FALSE;
    return ESC;
  }

  if (WindowActive)
  {
    if (KeyCount == 0) return -1;
    else
    {
      int key;
      key = Keys[KeyGet++];
      if (key >= 0x100)
      {
        Keys[--KeyGet] = key & 0xff;
        return ESC;
      }
      if (key == ESC)
      {
        /* Escape key press. Return 27 now, queue another */
        EscPending = TRUE;
        if (KeyGet >= KeyLength) KeyGet = 0;
        --KeyCount;
        return ESC;
      }
      if (KeyGet >= KeyLength)
        KeyGet = 0;
      --KeyCount;
      return key;
    }
  }
  else
  {
    int x = 0, y = 0;
    (void)os_byte(0x81, &x, &y);
    return (y == 0) ? x : -1;
  }
}

/* Read key from keyboard ------------------------------------------------------------------------------- */

PUBLIC BYTE GetAKey(void)
{
  if (WindowActive)
  {
#ifdef DWINDOW
    DWindow_Select(DWindow_Key);
#endif
    while (KeyCount == 0 && !EscPending) event_process();
#ifdef DWINDOW
    DWindow_Select(DWindow_None);
#endif
    return (BYTE)PollKey();
  }
  else
  {
    int key;
    (void)os_swi1r(0x20004, 0, &key);
    return key;
  }
}

