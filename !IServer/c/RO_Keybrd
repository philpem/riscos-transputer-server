#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "inmos.h"
#include "iserver.h"

#include "event.h"
#include "os.h"
#include "wimp.h"
#include "wimpt.h"

#include "DWindow.h"

/*
 *      KeyLength defines the length of the internal circular buffer
 *
 *      Keys[] is the circular buffer storing keypresses (as Wimp codes)
 *      KeyCount counts the number of characters in the buffer
 *      KeyPut and KeyGet are the insertion and removal indices
 */

#define KeyLength 256

PRIVATE int  Keys[KeyLength];
PRIVATE int  KeyCount   = 0;
PRIVATE int  KeyPut     = 0;
PRIVATE int  KeyGet     = 0;

#define ESC 27

#define MOD_SHIFT 1
#define MOD_CTRL  2
#define MOD_ALT   4

EXTERN BOOL WindowActive;

/* Buffer insertion ===================================================================================== */

/* Insert keypress into buffer -------------------------------------------------------------------------- */

PRIVATE VOID QueueByte(int key)
{
  /* Ignore keypress if buffer full */
  if (KeyCount < KeyLength)
  {
    KeyCount++;
    /* translate CR to LF */
    Keys[KeyPut++] = (key == 13 ? 10 : key);
    if (KeyPut >= KeyLength) KeyPut = 0;
  }
}

/* Use OS_Byte to get modifier status ------------------------------------------------------------------- */

PRIVATE int GetModifiers(void)
{
    int x, y;
    int mods = 0;

    /* Shift */
    x = 0x80;
    os_byte(121, &x, &y);
    if (x == 0xFF)
        mods |= MOD_SHIFT;

    /* Ctrl */
    x = 0x81;
    os_byte(121, &x, &y);
    if (x == 0xFF)
        mods |= MOD_CTRL;

    /* Alt */
    x = 0x82;
    os_byte(121, &x, &y);
    if (x == 0xFF)
        mods |= MOD_ALT;

    return mods;
}

/* Translate keypress and insert into buffer ------------------------------------------------------------ */

PUBLIC VOID KeyPressed(int key)
{
  int alt;

  /* Ignore all f12 variants */
  if ((key & 0x1cf) == 0x1cc)
  {
    wimpt_noerr(wimp_processkey(key));
    return;
  }

  /* ALT is missing from the WIMP encoding */
  alt = (GetModifiers() & MOD_ALT) ? 1 : 0;

  if (key == ESC) {
    /* Bare escape key -> ESC ESC */
    QueueByte(ESC); QueueByte(ESC);
  }
  else if (key >= 0x100)
  {
    /* Keys >= 0x100 are coded as ESC, Key&FF */
    if (alt) {
      /* Alt+special*/
      QueueByte(ESC); QueueByte(ESC);
    }

    QueueByte(ESC);
    QueueByte(key & 0xFF);
  }
  else
  {
    /* Bare ASCII key */
    if (alt) {
      /* Alt+ASCII */
      QueueByte(ESC); QueueByte(ESC);
    }
    QueueByte(key);
  }
}

/* Buffer removal ======================================================================================= */

/* Poll for key press ----------------------------------------------------------------------------------- */

PUBLIC int PollKey(void)
{
  if (WindowActive)
  {
    if (KeyCount == 0) return -1;
    else
    {
      int key;
      key = Keys[KeyGet++];
      if (KeyGet >= KeyLength)
        KeyGet = 0;
      --KeyCount;
      return key;
    }
  }
  else
  {
    int x = 0, y = 0;
    (void)os_byte(0x81, &x, &y);
    return (y == 0) ? x : -1;
  }
}

/* Read key from keyboard ------------------------------------------------------------------------------- */

PUBLIC BYTE GetAKey(void)
{
  if (WindowActive)
  {
#ifdef DWINDOW
    DWindow_Select(DWindow_Key);
#endif
    while (KeyCount == 0) event_process();
#ifdef DWINDOW
    DWindow_Select(DWindow_None);
#endif
    return (BYTE)PollKey();
  }
  else
  {
    int key;
    (void)os_swi1r(0x20004, 0, &key);
    return key;
  }
}

