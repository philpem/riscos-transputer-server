/*  File operations
**  May be replaced later by direct calls on MS-DOS functions
**  All return F_OK if end normally, OPERATIONFAILED_ERR otherwise; also
**  set streamp->result.   file_read and file_reads can return F_EOF too
*/

/*  file_position
**  This function positions a file to a location.   The location is
**  specified by an offset and an origin, like the C fseek function.
**  The origins are as follows:
**     EOF_POSITION   End of file.   (NB: on a text file, the
**                    next read will get EOF, the next write will
**                    overwrite the CTRL/Z
**     BOF_POSITION   The first char in the file
**     REL_POSITION   The current position
**  With EOF_POSITION, only an offset of 0 will work.
*/
int file_position (streamp, offset, origin)
struct STREAM_DESC *streamp;
int origin;
long offset;
{
   int res=F_OK, ans=0;
   long pos=0L, reclen=0L;
   if ((streamp->access_m == BINARYSEQUENTIAL_ACCESS) &&
       (origin == EOF_POSITION) && (offset == 0L)) {
      while (fseek(streamp->fileptr, pos, BOF_POSITION) == 0 &&
             fread (&reclen, 1, 4, streamp->fileptr) == 4    &&
             reclen != -1L)
         pos += reclen + 8;
      clearerr (streamp->fileptr);
      if (reclen == -1L)
         pos = -4L;
      else
         pos = 0L;
      ans = fseek (streamp->fileptr, pos, REL_POSITION);
   } else {
      ans = fseek (streamp->fileptr, offset, origin);
   }
   if (ans != 0) {
      res = OPERATIONFAILED_ERR;
      streamp->result = make_af_err(ferror(streamp->fileptr));
   }
   return (res);
}

/*  file_tell_position
**  Return current position of file
*/
long file_tell_position (streamp)
struct STREAM_DESC *streamp;
{
   return (ftell (streamp->fileptr));
}

/*  file_write
**  Write a sequence of bytes to a file
*/
int file_write (streamp, buffer, buflen)
struct STREAM_DESC *streamp;
char *buffer;
int buflen;
{
   int res=F_OK, ans;
   if (streamp->state != WRITING_STATE)
      fseek (streamp->fileptr, 0L, REL_POSITION);
   ans = fwrite (buffer, 1, buflen, streamp->fileptr);
   if (streamp->state != WRITING_STATE)
      fseek (streamp->fileptr, 0L, REL_POSITION);
   if (ans != buflen) {
      streamp->result = make_af_err(ferror(streamp->fileptr));
      res = OPERATIONFAILED_ERR;
   }
   return (res);
}

/*  file_read
**  Read a sequence of bytes from a file
*/
int file_read (streamp, buffer, buflen, bytes_read)
struct STREAM_DESC *streamp;
char *buffer;
int buflen, *bytes_read;
{
   int res=F_OK, ans;
   *bytes_read = fread(buffer, 1, buflen, streamp->fileptr);
   if (feof(streamp->fileptr)) {
      streamp->result = F_EOF;
      res = F_EOF;
   } else {
      ans = ferror(streamp->fileptr);
      streamp->result = make_af_err(ferror(streamp->fileptr));
      if (ans != 0)
         res = OPERATIONFAILED_ERR;
   }
   return (res);
}

/*  file_reads
**  Read a string from a file
**  bytes_read returned includes NL but excludes \0
*/
int file_reads (streamp, buffer, buflen, bytes_read)
struct STREAM_DESC *streamp;
char *buffer;
int buflen, *bytes_read;
{
   int res=F_OK, ans, temp, t;
   if (fgets (buffer, buflen+1, streamp->fileptr) == NULL) {
      *bytes_read = 0;
      if (feof(streamp->fileptr)) {
         streamp->result = F_EOF;
         res = F_EOF;
      } else {
         ans = ferror(streamp->fileptr);
         streamp->result = make_af_err(ferror(streamp->fileptr));
         if (ans != 0)
            res = OPERATIONFAILED_ERR;
      }
   } else {
      *bytes_read = strlen (buffer) -1;
      if (*buffer == CONTROL_Z) {
         *bytes_read = 0;
         streamp->result = F_EOF;
         res = F_EOF;
      } else if (buffer [*bytes_read-1] == CR)
         *bytes_read -= 1;
   }
   return (res);
}

/* file_backspace
** This will backspace binseq or txtseq files
** All other kinds -> OPERATIONFAILED_ERR
** Multiple backspaces allowed.  Attempt to backspace when
** at start of file -> OPERATIONFAILED_ERR
*/
int file_backspace (streamp)
struct STREAM_DESC *streamp;
{
   int res = F_OK, bytes_read, ch;
   long reclen;
   if (streamp->access_m == BINARYSEQUENTIAL_ACCESS) {

      if ((res = file_position(streamp, -4L, REL_POSITION)) == F_OK)
      if ((res = file_read(streamp, &reclen, 4, &bytes_read)) == F_OK) {
         if (reclen == -1)
            reclen = 4;
         else
            reclen += 8;
         res = file_position(streamp, (long)(-reclen), REL_POSITION);
      }

   } else if (streamp->access_m == TEXTSEQUENTIAL_ACCESS) {

      if (fseek(streamp->fileptr, -1L, REL_POSITION) == 0) {
         ch = fgetc (streamp->fileptr);
         do {
            if (fseek (streamp->fileptr, -2L, REL_POSITION) != 0) {
               /* we have reached start of file */
               rewind(streamp->fileptr);    /* clear error etc */
               break;
            }
            ch = fgetc (streamp->fileptr);
         } while (ch != LF);
      } else {
         /* was as start of the file to begin with  */
         rewind(streamp->fileptr);   /* clear error etc */
         res = OPERATIONFAILED_ERR;
      }

   } else
      /* not one of the types we can deal with */
      res = OPERATIONFAILED_ERR;

   return (res);
}

/* Terminate a record */
int terminate_record (streamp)
struct STREAM_DESC *streamp;
{
   int res = F_OK;
   long minus_one = -1L;
   int newl = 0x0a0d;  /* CR-LF */
   if (streamp->access_m == BINARYSEQUENTIAL_ACCESS) {
      res = file_write (streamp, &streamp->transferred, 4);
      if (streamp->recl == -1) {
         res += file_position (streamp,
                   (long)(-(streamp->transferred + 8)), REL_POSITION);
         res += file_write (streamp, &streamp->transferred, 4);
         res += file_position (streamp,
                   (long)(streamp->transferred + 4), REL_POSITION);
      }
   } else if (streamp->access_m == TEXTBYTESTREAM_ACCESS ||
             streamp->access_m == TEXTSEQUENTIAL_ACCESS) {
      if (streamp->suppress_nl)
         streamp->suppress_nl = FALSE;
      else
         res += file_write (streamp, &newl, 2);
   }
   return (res);
}

/* Write an end-of-file (if there is any such thing)
** The second parameter controls where the file is left
*/
int terminate_file (streamp, leave_after_eof)
struct STREAM_DESC *streamp;
int leave_after_eof;
{
   int res = F_OK, len = 0;
   long minus_one = -1L;
   char ctrlz = CONTROL_Z, *p;
   if (streamp->access_m == BINARYSEQUENTIAL_ACCESS) {
      p = (char *)&minus_one; len=4;
   } else if (streamp->access_m == TEXTBYTESTREAM_ACCESS ||
             streamp->access_m == TEXTSEQUENTIAL_ACCESS) {
      p = &ctrlz; len=1;
   } else return (res);
   if ((res = file_write (streamp, p, len)) == F_OK)
   if (!leave_after_eof)
      res = file_position (streamp, (long)(-len), REL_POSITION);
   return (res);
}

/* Adjust state */
int adjust_state (streamp, new_state)
struct STREAM_DESC *streamp;
int new_state;
{
   int res = F_OK;
   long minus_one = -1L;
   char newl = LF;
   if (streamp->state == WRITING_STATE) {
      res = terminate_record (streamp);
/* Rev 006      if (res == F_OK && new_state != WRITING_STATE ) */

      if (res == F_OK && new_state != WRITING_STATE    /* Rev 006 begin */
#ifdef RISCOS
                  && streamp->lifetime_m != SPECIAL) {  /* Rev 006 end */
#else
                  && !isatty(fileno(streamp->fileptr))) {  /* Rev 006 end */
#endif
         res = terminate_file (streamp, FALSE);
      }
   } else if ((streamp->state == READING_STATE) &&
              (streamp->access_m == BINARYSEQUENTIAL_ACCESS))
       if (streamp->recl != -1)                    /* Rev 005 */
         res = file_position (streamp,
                           (long)((streamp->recl-streamp->transferred)+4),
                           REL_POSITION);
   if (res != F_OK)
      res = OPERATIONFAILED_ERR;
   else
      streamp->state = new_state;
   return (res);
}

