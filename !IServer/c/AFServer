    {
        write_long_integer(block_size);
        write_integer(F_OK);
    }
#endif
}
#define NO_PROCESS_REGS 10
void call_interrupt ()
{
#ifdef RISCOS
    int interrupt, block_size;
    char buffer[RECORD_LENGTH];

    if (read_integer(&interrupt))
    if (read_record(&block_size, buffer))
    {
        write_integer(0);
        write_record(0, "");
        write_integer(OPERATIONFAILED_ERR);
    }
#else
    unsigned value, i;
    unsigned reg_vals [NO_PROCESS_REGS];
    int res, flag, interrupt, block_size;
    unsigned char buffer [RECORD_LENGTH];
    struct SREGS _segregs;
    struct SREGS *segregs = &_segregs;

    union REGS _inregs, _outregs;
    union REGS *inregs = &_inregs,
               *outregs = &_outregs;

    if (read_integer(&interrupt))
    if (read_record (&block_size, buffer))
    {
        if ((block_size/4) == NO_PROCESS_REGS)
        {
            for (i = 0; i < (NO_PROCESS_REGS*4); i+=4)    /* 4 bytes to a word */
            {
                /* host and transputer dependant - ignore m.s. 2 bytes as not used */
                value = buffer[i + 1];                    /* m.s. byte */
                value = (value << 8) | buffer[i];         /* l.s. byte */
                reg_vals[i/4] = value;
            }
            inregs->x.ax = reg_vals[0];
            inregs->x.bx = reg_vals[1];
            inregs->x.cx = reg_vals[2];
            inregs->x.dx = reg_vals[3];
            inregs->x.di = reg_vals[4];
            inregs->x.si = reg_vals[5];
            segregs->cs = reg_vals[6];
            segregs->ds = reg_vals[7];
            segregs->es = reg_vals[8];
            segregs->ss = reg_vals[9];
            int86x(interrupt, inregs, outregs, segregs);
            reg_vals[0] = outregs->x.ax;
            reg_vals[1] = outregs->x.bx;
            reg_vals[2] = outregs->x.cx;
            reg_vals[3] = outregs->x.dx;
            reg_vals[4] = outregs->x.di;
            reg_vals[5] = outregs->x.si;
            reg_vals[6] = segregs->cs;
            reg_vals[7] = segregs->ds;
            reg_vals[8] = segregs->es;
            reg_vals[9] = segregs->ss;
            for (i = 0; i < (NO_PROCESS_REGS*4); i+=4)    /* 4 bytes to a word */
            {
                value = reg_vals[i/4];
                /* host and transputer dependant */
                buffer[i] = value & 0xff;                 /* l.s. byte */
                buffer[i + 1] = (value >> 8) & 0xff;
                buffer[i + 2] = 0x0;
                buffer[i + 3] = 0x0;                      /* m.s. byte */
            }
            flag = outregs->x.cflag;
            res = F_OK;
        }
        else
            res = OPERATIONFAILED_ERR;
        write_integer(flag);
        write_record ((NO_PROCESS_REGS*4), buffer);
        write_integer(res);
    }
#endif
}
#undef NO_PROCESS_REGS
#define NO_SEG_REGS 4
void read_regs ()
{
#ifdef RISCOS
    write_record(0, "");
    write_integer(OPERATIONFAILED_ERR);
#else
    unsigned value, i;
    unsigned char buffer [RECORD_LENGTH];
    unsigned reg_vals [NO_SEG_REGS];
    struct SREGS _segregs;
    struct SREGS *segregs = &_segregs;

    segread(segregs);                         /* get segment registers */
    reg_vals[0] = segregs->cs;
    reg_vals[1] = segregs->ds;
    reg_vals[2] = segregs->es;
    reg_vals[3] = segregs->ss;
    for (i = 0; i < (NO_SEG_REGS*4); i+=4)
    {
        value = reg_vals[i/4];
        /* host and transputer dependant */
        buffer[i] = value & 0xff;             /* l.s. byte */
        buffer[i + 1] = (value >> 8) & 0xff;
        buffer[i + 2] = 0x0;
        buffer[i + 3] = 0x0;                  /* m.s. byte */
    }
    write_record (NO_SEG_REGS*4, buffer);
    write_integer(F_OK);
#endif
}
