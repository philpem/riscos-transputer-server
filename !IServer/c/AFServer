/* User service: Stream Record Length */
void stream_recordlength ()
{
   int res = F_OK, stream_id = INVALID_STREAM;
   long first = -1L, second = -1L;
   long int third = 0L;   /* Rev 003 */
   if (read_integer(&stream_id)) {
