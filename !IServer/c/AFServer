            second = TEXTSEQRECL_MAX;
         else if (streamp->access_m == BINARYDIRECT_ACCESS ||
                    streamp->access_m == TEXTDIRECT_ACCESS)    {
            first  = streamp->recl;
            second = streamp->recl;
            third  = streamp->recl;    /* Rev 003 */
         } else
            second = -(BINSEQRECL_MAX);
      } else
         res = INVALIDSTREAMID_ERR;
      write_long_integer (first);
      write_long_integer (second);
      write_long_integer (third);      /* Rev 003 */
      write_integer (res);
   }
}

/* User service: Read Record */
void record_read ()
{
/* int res = F_OK, recspec, maxlen, bytes_read=0;    Rev 003 */
   int res = F_OK, maxlen, bytes_read=0;          /* Rev 003 */
   long recspec;                                  /* Rev 003 */
   long trl=0L;
   int stream_id = INVALID_STREAM;
   char buffer [RECORD_LENGTH], *bp=buffer;
   struct STREAM_DESC *streamp;

   if (read_integer (&stream_id))
/* if (read_integer (&recspec))                      Rev 003 */
   if (read_long_integer (&recspec))              /* Rev 003 */
   if (read_integer (&maxlen))
   if (valid_stream (stream_id)) {
      streamp = &filers[stream_id];
      if (streamp->access_m == BINARYDIRECT_ACCESS ||
          streamp->access_m == TEXTDIRECT_ACCESS) {

         /* direct version */
/*       if (recspec != -1 ) {                       Rev 003 */
         if (recspec & START_OF_RECORD) {         /* Rev 003 */
            if ((res=adjust_state(streamp, READING_STATE)) == F_OK)
               res = file_position (streamp,
/*                                  (long)((recspec-1)*streamp->recl),    003 */
/* Rev 003 */                       (long)(((recspec & RECORD_NUM_MASK)-1)
/* Rev 003 */                                * streamp->recl),
                                    BOF_POSITION);
            if (res != F_OK)
               maxlen = 0;
            streamp->transferred = 0;
         }
         trl = streamp->recl;
         if ((maxlen+streamp->transferred) > streamp->recl)
            maxlen = streamp->recl - streamp->transferred;
/* Rev 004
         if (maxlen > 0) */
         if (maxlen >= 0) {  /* Rev 004 */
            res = file_read (streamp, buffer, maxlen, &bytes_read);
         }
      } else if (streamp->access_m == TEXTBYTESTREAM_ACCESS ||
                 streamp->access_m == TEXTSEQUENTIAL_ACCESS) {

         /* text version */
/*       if (recspec >= 0) {                             Rev 003 */
         if (recspec & START_OF_RECORD) {             /* Rev 003 */
            if ((res=adjust_state(streamp, READING_STATE)) == F_OK) {
               if (streamp->text_buff == NULL)
               if ((streamp->text_buff=malloc(TEXTSEQRECL_MAX+2)) == NULL)
                  terminate_server (T_OUT_OF_MEMORY);
               res = file_reads (streamp, streamp->text_buff,
                                 TEXTSEQRECL_MAX, &bytes_read);
            }
            streamp->recl = bytes_read;
            streamp->transferred = 0;
            trl = streamp->recl;
         }
         if ((maxlen+streamp->transferred) > streamp->recl)
            maxlen = streamp->recl - streamp->transferred;
         bp = &streamp->text_buff[streamp->transferred];
         bytes_read = maxlen;

      } else if (streamp->access_m == BINARYSEQUENTIAL_ACCESS) {

         /* bin-seq version */
/*       if (recspec >= 0) {                          Rev 003 */
         if (recspec & START_OF_RECORD) {          /* Rev 003 */
            if ((res=adjust_state(streamp, READING_STATE)) == F_OK)
               res = file_read (streamp, &trl, 4, &bytes_read);
            if (res != F_OK)
               maxlen = 0;
            else if (trl == -1L) {
               res = file_position (streamp, -4L, REL_POSITION);
               maxlen = 0;
               res = F_EOF;
            }
            streamp->transferred = 0;
            streamp->recl = trl;
         }
         if ((maxlen+streamp->transferred) > streamp->recl)
            maxlen = streamp->recl - streamp->transferred;
/* Rev 004 if (maxlen > 0) */
         if (maxlen >= 0)        /* Rev 004 */
            res = file_read (streamp, buffer, maxlen, &bytes_read);

      } else {

         /* binary bytestreams: fudge it */
/*       if (recspec >= 0) {                       Rev 003 */
         if (recspec & START_OF_RECORD) {       /* Rev 003 */
            adjust_state (streamp, READING_STATE);
            trl = maxlen;
            streamp->recl = maxlen;
/* Rev 004  if (maxlen > 0) */
            if (maxlen >= 0)       /* Rev 004 */
               res = file_read (streamp, buffer, maxlen, &bytes_read);
            if (res == F_OK)
               streamp->transferred = 0;
         }
      }

      if (recspec & END_OF_RECORD)                             /* Rev 003 */
         res = adjust_state(streamp, WAITING_STATE);           /* Rev 003 */

      write_long_integer (trl);
      write_record (bytes_read, bp);
      write_integer (res);
      streamp->transferred += bytes_read;
   }
}

