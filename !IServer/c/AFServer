static void afserver_command_line()
{
    extern BYTE DoctoredCommandLine[];
    char *p = (char *)DoctoredCommandLine;

    tcominptr = 0;
    tcomoutptr = 0;
    while (*p != '\0' && tcominptr < COMMAND_LINE_LENGTH - 1)
    {
        while (*p == ' ')
            ++p;
        if ((p[0] == '-' || p[0] == '/') && p[1] == ':' &&
            (p[2] == 'o' || p[2] == 'O'))
        {
            p += 3;
            while (*p == ' ')
                ++p;
            alien_option_flag = read_number(p);
            while (*p != '\0' && *p != ' ')
                ++p;
        }
        else
        {
            while (*p != '\0' && *p != ' ' && tcominptr < COMMAND_LINE_LENGTH - 1)
                tcom[tcominptr++] = *p++;
            if (tcominptr < COMMAND_LINE_LENGTH - 1)
                tcom[tcominptr++] = ' ';
        }
    }
    if (tcominptr != 0 && tcom[tcominptr - 1] != ' ' &&
        tcominptr < COMMAND_LINE_LENGTH - 1)
        tcom[tcominptr++] = ' ';
}

