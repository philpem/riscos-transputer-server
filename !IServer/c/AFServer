#ifdef RISCOS
static int af_read_bytes(buffer, length)
    char *buffer;
    int length;
{
    int got = ReadLink(TheLink, (BYTE *)buffer, length, 0);
    if (got != length)
        ABORT((SE, "AFServer protocol error reading %d bytes, got %d", length, got));
    return got;
}

static void af_write_bytes(buffer, length)
    char *buffer;
    int length;
{
    int sent = WriteLink(TheLink, (BYTE *)buffer, length, 0);
    if (sent != length)
        ABORT((SE, "AFServer protocol error writing %d bytes, sent %d", length, sent));
}

int byte_from_link()
{
    unsigned char b;
    af_read_bytes((char *)&b, 1);
    return (int)b;
}

void byte_to_link(b)
    int b;
{
    unsigned char c = (unsigned char)b;
    af_write_bytes((char *)&c, 1);
}

int word_from_link()
{
    int lo = byte_from_link();
    int hi = byte_from_link();
    (void)byte_from_link();
    (void)byte_from_link();
    return lo | (hi << 8);
}

void word_to_link(w)
    int w;
{
    byte_to_link(w & 0xff);
    byte_to_link((w >> 8) & 0xff);
    if (w & 0x8000)
    {
        byte_to_link(0xff);
        byte_to_link(0xff);
    }
    else
    {
        byte_to_link(0);
        byte_to_link(0);
    }
}

void long_word_to_link(w)
    long int w;
{
    int i;
    for (i = 0; i < 4; i++)
    {
        byte_to_link((int)(w & 0xff));
        w >>= 8;
    }
}

long int long_word_from_link()
{
    long int result = 0L;
    int i;
    for (i = 0; i < 32; i += 8)
        result |= (((long int)byte_from_link()) << i);
    return result;
}

void get_long_slice(length, slice)
    int length;
    char far *slice;
{
    if (length > 0)
        af_read_bytes((char *)slice, length);
}

int trunc_slice_from_link(max_length, str)
    int max_length;
    char *str;
{
    int i, length, keep;

    length = word_from_link();
    keep = (length > max_length) ? max_length : length;
    for (i = 0; i < keep; i++)
        str[i] = (char)byte_from_link();
    for (; i < length; i++)
        (void)byte_from_link();
#ifdef REV_A_FIX
    if (length == 1)
        (void)byte_from_link();
#endif
    return keep;
}

void slice_to_link(length, slice)
    int length;
    char *slice;
{
    int i, real_len = length;
    word_to_link(real_len);
#ifdef REV_A_FIX
    if (real_len == 1) real_len = 2;
#endif
    for (i = 0; i < length; i++)
        byte_to_link(slice[i]);
#ifdef REV_A_FIX
    if (length == 1)
        byte_to_link(0);
#endif
}

void long_slice_to_link(length, slice)
    long int length;
    char far *slice;
{
    long int i, real_len = length;
    long_word_to_link(real_len);
#ifdef REV_A_FIX
    if (real_len == 1) real_len = 2;
#endif
    for (i = 0; i < length; i++)
        byte_to_link(slice[i]);
#ifdef REV_A_FIX
    if (length == 1)
        byte_to_link(0);
#endif
}

void long_slice_from_link(length, slice)
    long int *length;
    char far *slice;
{
    long int real_len, i;
    *length = real_len = long_word_from_link();
    for (i = 0; i < real_len; i++)
        slice[i] = (char)byte_from_link();
#ifdef REV_A_FIX
    if (real_len == 1)
        (void)byte_from_link();
#endif
}
